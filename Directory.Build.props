<Project>

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<LangVersion>latest</LangVersion>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
	<AnalysisLevel>latest</AnalysisLevel>
	<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
      
  </PropertyGroup>

  <PropertyGroup>
	<VersionPrefix>0.1.0</VersionPrefix>
	<Authors>Instancium</Authors>
	<Company>Instancium</Company>
	<Product>Instancium Lens</Product>
	<Copyright>Copyright (c) Instancium</Copyright>
	<RepositoryType>git</RepositoryType>
      <Version>Release v1.2.0-rc.1</Version>
  </PropertyGroup>

  <!-- Test projects are identified by naming convention so policy stays declarative. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
	<IsTestProject>true</IsTestProject>
	<GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
