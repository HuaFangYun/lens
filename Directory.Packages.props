    <PackageVersion Include="InstantAIGate.Core" Version="1.5.3" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Instancium.Vectra" Version="1.1.1" />
  </ItemGroup>
</Project>
