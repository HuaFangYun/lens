@inherits LayoutComponentBase

<div class="shell">
    <header class="shell__topbar">
        <span class="shell__brand">
            <img class="shell__brand-logo" src="imgs/logo-icon-white.png"
                 alt="Instancium Lens Logo" width="28" height="28" />
            Instancium Lens
        </span>
        <nav class="shell__nav">
            <NavLink class="shell__nav-link" Href="" Match="NavLinkMatch.All">Index</NavLink>
            <NavLink class="shell__nav-link" Href="chat">Chat</NavLink>
        </nav>
    </header>
    <main class="shell__content">
        @Body
    </main>
</div>
