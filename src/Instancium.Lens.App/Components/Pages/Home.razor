@page "/"
@implements IAsyncDisposable
@inject AppState State
@inject IIngestionService Ingestion
@inject IFolderPicker FolderPicker
@inject IIndexLocationRegistry IndexLocations
@inject IIndexStateStore IndexStates
@inject IIndexLocationResolver LocationResolver
@inject IJSRuntime JS

<section class="home">
    <h1 class="home__title">Index Documents</h1>
    <p class="hint home__subtitle">
        Pick a folder; Lens parses, chunks and embeds every supported document into the profile index.
    </p>

    <div class="home__stats">
        <div class="home__stats-head">
            <label class="home__label" for="home-profile">Profile</label>
            <input id="home-profile" class="text-input home__profile"
                   @bind="State.ProfileId" @bind:event="onchange" />
            <span class="home__state @StateClass">@StateLabel</span>
        </div>
        <dl class="home__facts">
            <div class="home__fact"><dt>Documents</dt><dd>@FactFiles</dd></div>
            <div class="home__fact"><dt>Chunks</dt><dd>@FactChunks</dd></div>
            <div class="home__fact"><dt>Updated</dt><dd>@FactUpdated</dd></div>
            <div class="home__fact home__fact--wide">
                <dt>Index location</dt>
                <dd class="mono">@IndexLocation</dd>
            </div>
        </dl>
        @if (HasBinding && Stats is null)
        {
            <p class="hint home__legacy-hint">
                This index was built before statistics tracking. The bound folder is preloaded
                below: run Index folder once to refresh documents, chunks and timestamp.
            </p>
        }
    </div>

    <div class="home__panel">
        <div class="home__row">
            <label class="home__label" for="home-folder">Folder</label>
            <input id="home-folder" class="text-input mono" readonly
                   value="@FolderPath" placeholder="No folder selected" />
            <button type="button" class="btn" disabled="@IsBusy" @onclick="PickFolder">Browse…</button>
        </div>
        @if (_previewCount is not null)
        {
            <p class="hint home__preview">
                @_previewCount supported documents found in the selected folder.
            </p>
        }
        <div class="home__row home__row--actions">
            <button type="button" class="btn btn--primary"
                    disabled="@(!CanIndex || IsBusy)" @onclick="IndexFolder">
                Index folder
            </button>
            <button type="button" class="btn" disabled="@(!IsBusy)" @onclick="Cancel">Cancel</button>
        </div>

        @if (IsBusy)
        {
            <div class="home__progress">
                <progress class="progress" max="100" value="@ProgressPercent"></progress>
                @if (!string.IsNullOrEmpty(CurrentFile))
                {
                    <span class="hint">Processing: @Path.GetFileName(CurrentFile)</span>
                }
                <span class="hint">@StatusText</span>
            </div>
        }

        @if (LastResult is not null)
        {
            <div class="banner banner--success">
                Indexed @LastResult.FilesProcessed documents into @LastResult.ChunksIndexed chunks.
            </div>
        }
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="banner banner--error" role="alert">@ErrorMessage</div>
        }
    </div>
</section>

@code {
    private IJSObjectReference? _module;
    private CancellationTokenSource? _cts;
    private string? FolderPath { get; set; }
    private int? _previewCount;
    private string? _prefilledProfile;
    private bool IsBusy { get; set; }
    private int ProgressPercent { get; set; }
    private string StatusText { get; set; } = string.Empty;
    private string? CurrentFile { get; set; }
    private string? ErrorMessage { get; set; }
    private IndexingResult? LastResult { get; set; }

    private ProfileIndexStats? Stats =>
        IndexStates.TryGetStats(State.ProfileId, out var stats) ? stats : null;
    private bool HasBinding =>
        IndexLocations.TryResolve(State.ProfileId, out var root) && !string.IsNullOrWhiteSpace(root);
    private string StateClass => Stats is not null
        ? "home__state--ready"
        : HasBinding ? "home__state--legacy" : "home__state--missing";
    private string StateLabel => Stats is not null
        ? "Index ready"
        : HasBinding ? "Index present" : "Not indexed";
    private string FactFiles => Stats?.FilesProcessed.ToString() ?? "—";
    private string FactChunks => Stats?.ChunksIndexed.ToString() ?? "—";
    private string FactUpdated => Stats?.UpdatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—";
    private bool CanIndex =>
        !string.IsNullOrWhiteSpace(FolderPath) && !string.IsNullOrWhiteSpace(State.ProfileId);

    private string IndexLocation => string.IsNullOrWhiteSpace(FolderPath)
        ? LocationResolver.ForProfile(State.ProfileId)
        : LocationResolver.ForFolder(FolderPath);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/pages/home.js");
        }
        if (!IsBusy && !string.Equals(State.ProfileId, _prefilledProfile, StringComparison.Ordinal))
        {
            _prefilledProfile = State.ProfileId;
            FolderPath = IndexLocations.TryResolve(State.ProfileId, out var bound)
                && !string.IsNullOrWhiteSpace(bound)
                ? bound
                : null;
            await RefreshPreviewAsync();
            StateHasChanged();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task PickFolder()
    {
        ErrorMessage = null;
        try
        {
            string? folderPath = await FolderPicker.PickFolderAsync();
            if (!string.IsNullOrWhiteSpace(folderPath))
            {
                FolderPath = folderPath;
                await RefreshPreviewAsync();
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Folder selection failed: {ex.Message}";
        }
    }

    private async Task IndexFolder()
    {
        if (!CanIndex || IsBusy)
        {
            return;
        }
        IsBusy = true;
        ErrorMessage = null;
        LastResult = null;
        ProgressPercent = 0;
        StatusText = "Starting…";
        CurrentFile = null;
        _cts = new CancellationTokenSource();
        try
        {
            await IndexLocations.BindAsync(State.ProfileId.Trim(), FolderPath!, _cts.Token);
            var progress = new Progress<IndexingProgress>(report =>
            {
                ProgressPercent = report.Percentage;
                CurrentFile = report.CurrentFile;

                if (report.CurrentFile is not null)
                {
                    var fileName = Path.GetFileName(report.CurrentFile);
                    var chunkPart = report.CurrentFileChunksTotal > 0
                        ? $"chunks {report.CurrentFileChunksProcessed}/{report.CurrentFileChunksTotal}"
                        : "parsing";
                    StatusText = $"{fileName}: {chunkPart} | files {report.FilesProcessed}/{report.TotalFiles} | total chunks {report.ChunksIndexed}";
                }
                else
                {
                    StatusText = $"Files {report.FilesProcessed}/{report.TotalFiles}, chunks {report.ChunksIndexed}";
                }

                _ = InvokeAsync(StateHasChanged);
            });

            Result<IndexingResult> outcome = await Task.Run(
                async () => await Ingestion.IndexFolderAsync(
                        State.ProfileId.Trim(),
                        FolderPath!,
                        progress,
                        _cts.Token)
                    .ConfigureAwait(false),
                _cts.Token).ConfigureAwait(false);

            if (outcome.IsSuccess)
            {
                LastResult = outcome.Value!;
                await IndexStates.RecordAsync(State.ProfileId.Trim(), outcome.Value!, CancellationToken.None);
                StatusText = "Done.";
            }
            else
            {
                ErrorMessage = $"{outcome.Error!.Code}: {outcome.Error.Message}";
                StatusText = string.Empty;
            }
        }
        catch (OperationCanceledException)
        {
            ErrorMessage = null;
            StatusText = "Cancelled.";
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Indexing failed: {ex.Message}";
            StatusText = string.Empty;
        }
        finally
        {
            IsBusy = false;
            _cts.Dispose();
            _cts = null;
        }
    }

    private void Cancel() => _cts?.Cancel();

    private async Task RefreshPreviewAsync()
    {
        if (string.IsNullOrWhiteSpace(FolderPath) || !Directory.Exists(FolderPath))
        {
            _previewCount = null;
            return;
        }
        var folder = FolderPath;
        _previewCount = await Task.Run(() => Directory
            .EnumerateFiles(folder, "*.*", SearchOption.AllDirectories)
            .Count(SupportedDocuments.IsSupported));
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
