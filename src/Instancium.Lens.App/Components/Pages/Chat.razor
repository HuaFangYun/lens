@page "/chat"
@implements IAsyncDisposable
@inject AppState State
@inject IChatService ChatService
@inject IIndexLocationRegistry IndexLocations
@inject IIndexStateStore IndexStates
@inject IIndexLocationResolver LocationResolver
@inject IJSRuntime JS

<section class="chat">
    <header class="chat__context">
        <div class="chat__context-head">
            <label class="chat__context-label" for="chat-profile">Profile</label>
            <input id="chat-profile" class="text-input chat__profile"
                   @bind="State.ProfileId" @bind:event="oninput" />
            <span class="chat__state @StateClass">@StateLabel</span>
        </div>
        <dl class="chat__facts">
            <div class="chat__fact">
                <dt>Documents</dt>
                <dd>@FactFiles</dd>
            </div>
            <div class="chat__fact">
                <dt>Chunks</dt>
                <dd>@FactChunks</dd>
            </div>
            <div class="chat__fact">
                <dt>Updated</dt>
                <dd>@FactUpdated</dd>
            </div>
            <div class="chat__fact chat__fact--wide">
                <dt>Source folder</dt>
                <dd class="mono">@FactSourceFolder</dd>
            </div>
            <div class="chat__fact chat__fact--wide">
                <dt>Index location</dt>
                <dd class="mono">@FactIndexLocation</dd>
            </div>
        </dl>
        @if (HasBinding && Stats is null)
        {
            <p class="chat__legacy-hint">
                This index was built before statistics tracking. Open Index and re-index the
                bound folder to refresh documents, chunks and timestamp.
            </p>
        }
    </header>

    @if (!HasBinding)
    {
        <div class="banner banner--warning" role="alert">
            This profile has no indexed documents yet. Open <a class="chat__link" href="">Index</a>
            and index a folder to unlock grounded answers.
        </div>
    }

    <div class="chat__transcript" @ref="_transcript">
        @if (_askedQuestion is not null)
        {
            <article class="chat__message chat__message--user">
                <span class="chat__message-label">Question</span>
                <p class="chat__message-text">@_askedQuestion</p>
            </article>
            <article class="chat__message chat__message--assistant">
                <span class="chat__message-label">Answer</span>
                @if (IsBusy)
                {
                    <p class="chat__stage"><span class="chat__stage-dot"></span>@StatusText</p>
                }
                <div class="markdown-body chat__stream">@VisibleAnswer</div>
                @if (Answer is not null && Answer.Citations.Count > 0)
                {
                    <section class="chat__citations">
                        <button type="button" class="chat__citations-toggle" @onclick="ToggleCitations">
                            @(_citationsOpen ? "Hide sources" : $"Show sources ({Answer.Citations.Count})")
                        </button>
                        @if (_citationsOpen)
                        {
                            <ol class="chat__citation-list">
                                @foreach (Citation citation in Answer.Citations)
                                {
                                    <li class="chat__citation">
                                        <button type="button" class="chat__citation-head"
                                                @onclick="() => ToggleCitation(citation.Number)">
                                            <span class="chat__citation-number">[@citation.Number]</span>
                                            <span class="chat__citation-source">@citation.Source · chunk @citation.ChunkIndex</span>
                                            <span class="chat__citation-caret">@(_expanded.Contains(citation.Number) ? "▾" : "▸")</span>
                                        </button>
                                        @if (_expanded.Contains(citation.Number))
                                        {
                                            <pre class="chat__citation-text">@citation.Text</pre>
                                        }
                                    </li>
                                }
                            </ol>
                        }
                    </section>
                }
            </article>
        }
        else
        {
            <p class="chat__empty">
                Ask anything about the indexed documents. The answer streams in token by token
                and every fact keeps a clickable source.
            </p>
        }
    </div>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="banner banner--error" role="alert">@ErrorMessage</div>
    }

    <footer class="chat__composer">
        <textarea class="text-input chat__question" rows="2"
                  placeholder="Ask about the indexed documents…"
                  @bind="Question" @bind:event="oninput"></textarea>
        <button type="button" class="btn btn--primary chat__ask"
                disabled="@(!CanAsk || IsBusy)" @onclick="Ask">
            Ask
        </button>
    </footer>
</section>

@code {
    private IJSObjectReference? _module;
    private ElementReference _transcript;
    private readonly System.Text.StringBuilder _stream = new();
    private readonly HashSet<int> _expanded = new();
    private string Question { get; set; } = string.Empty;
    private string? _askedQuestion;
    private bool IsBusy { get; set; }
    private string StatusText { get; set; } = string.Empty;
    private string StreamingText { get; set; } = string.Empty;
    private string? ErrorMessage { get; set; }
    private ChatAnswer? Answer { get; set; }
    private bool _citationsOpen = true;

    private string ProfileId => State.ProfileId;
    private ProfileIndexStats? Stats =>
        IndexStates.TryGetStats(ProfileId, out var stats) ? stats : null;
    private bool HasBinding =>
        IndexLocations.TryResolve(ProfileId, out var root) && !string.IsNullOrWhiteSpace(root);
    private string StateClass => Stats is not null
        ? "chat__state--ready"
        : HasBinding ? "chat__state--legacy" : "chat__state--missing";
    private string StateLabel => Stats is not null
        ? "Index ready"
        : HasBinding ? "Index present" : "Not indexed";
    private string FactFiles => Stats?.FilesProcessed.ToString() ?? "—";
    private string FactChunks => Stats?.ChunksIndexed.ToString() ?? "—";
    private string FactUpdated => Stats?.UpdatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—";
    private string FactSourceFolder =>
        IndexLocations.TryResolve(ProfileId, out var root) && !string.IsNullOrWhiteSpace(root)
            ? root
            : "not bound yet";
    private string FactIndexLocation => LocationResolver.ForProfile(ProfileId);
    private string VisibleAnswer => Answer is not null ? Answer.Text : StreamingText;
    private bool CanAsk =>
        !string.IsNullOrWhiteSpace(Question) && !string.IsNullOrWhiteSpace(ProfileId);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/pages/chat.js");
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task Ask()
    {
        if (!CanAsk || IsBusy)
        {
            return;
        }
        IsBusy = true;
        ErrorMessage = null;
        Answer = null;
        _expanded.Clear();
        _citationsOpen = true;
        _askedQuestion = Question.Trim();
        _stream.Clear();
        StreamingText = string.Empty;
        StatusText = "Retrieving context…";
        var progress = new Progress<ChatProgress>(OnProgress);
        try
        {
            Result<ChatAnswer> outcome = await ChatService.AskStreamingAsync(
                ProfileId.Trim(), _askedQuestion, progress, default);
            if (outcome.IsSuccess)
            {
                Answer = outcome.Value!;
            }
            else
            {
                ErrorMessage = $"{outcome.Error!.Code}: {outcome.Error.Message}";
            }
            StatusText = string.Empty;
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Ask failed: {ex.Message}";
            StatusText = string.Empty;
        }
        finally
        {
            IsBusy = false;
            _stream.Clear();
            StreamingText = string.Empty;
            RequestScroll();
        }
    }

    private void OnProgress(ChatProgress report)
    {
        _ = InvokeAsync(() =>
        {
            if (report.Stage == ChatStage.Retrieving)
            {
                StatusText = "Retrieving context…";
            }
            else
            {
                StatusText = "Generating answer…";
                if (report.Token is not null)
                {
                    _stream.Append(report.Token);
                    StreamingText = _stream.ToString();
                }
            }
            StateHasChanged();
            RequestScroll();
        });
    }

    private void ToggleCitations() => _citationsOpen = !_citationsOpen;

    private void ToggleCitation(int number)
    {
        if (!_expanded.Remove(number))
        {
            _expanded.Add(number);
        }
    }

    private void RequestScroll() => _ = InvokeAsync(ScrollAsync);

    private async Task ScrollAsync()
    {
        if (_module is null)
        {
            return;
        }
        try
        {
            await _module.InvokeVoidAsync("scrollToEnd", _transcript);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
